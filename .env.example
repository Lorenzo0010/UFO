# Chiave API TMDB (Obbligatoria per i metadati e la risoluzione ID)
TMDB_KEY=la_tua_api_key_tmdb

# Base URL dell'addon (Consigliata se usato fuori dalla rete locale o con più client)
# Esempio: http://192.168.1.77:8080 oppure https://mio-ufo-server.koyeb.app
ADDON_BASE_URL=

# Abilita o disabilita il provider VidXgo (1 = abilitato, 0 = disabilitato)
VIDXGO_ENABLED=1

# (Opzionale) Dominio per VixSrc/StreamingCommunity
# SC_DOMAIN=https://vixsrc.to

# (Opzionale) Dominio per VidXgo
# VIDXGO_DOMAIN=https://v.vidxgo.co
